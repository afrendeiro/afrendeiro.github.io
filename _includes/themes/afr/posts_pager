{% comment %}
This gets previous and next posts which are not of a category to exclude 
(passed as the exclude variable) and returns pagers.
{% endcomment %}
{% for i in (1..100) %}
	{% if i == 1 %}
		{% assign prev = page.previous %}
	{% else %}
		{% assign prev = prev.previous %}
	{% endif %}
	{% if prev %}
		{% if prev.category != exclude %}
			<li class="page-item"><a class="page-link" href="{{ BASE_PATH }}{{ prev.url }}" title="{{ prev.title }}">&larr; Previous</a></li>
			{% break %}
		{% endif %}
	{% else %}
		<li class="page-item disabled"><a class="page-link">&larr; Previous</a></li>
		{% break %}
	{% endif %}
{% endfor %}
<li class="page-item"><a class="page-link" href="{{ BASE_PATH }}{{ site.JB.posts_path }}">All posts</a></li>
{% for i in (1..100) %}
	{% if i == 1 %}
		{% assign nex = page.next %}
	{% else %}
		{% assign nex = nex.next %}
	{% endif %}
	{% if nex %}
		{% if nex.category != exclude %}
			<li class="page-item"><a class="page-link" href="{{ BASE_PATH }}{{ nex.url }}" title="{{ nex.title }}">&rarr; Next</a></li>
			{% break %}
		{% endif %}
	{% else %}
		<li class="page-item disabled"><a class="page-link">&rarr; Next</a></li>
		{% break %}
	{% endif %}
{% endfor %}
