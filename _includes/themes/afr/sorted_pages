{% comment %}
Adds list of pages sorted alphabetically. Supports group filtering (e.g. navigation pages).
Usefull for sorting pages in navbars.
{% endcomment %}

{% for node in sorted_pages %}
	{% if node.title != null %}
		{% if group == null or group == node.group %}
			{% if node.url == page.url %}
				<li class="nav-item"><a href="{{ BASE_PATH }}{{node.url}}" class="nav-link active" aria-current="page">{{node.title}}</a></li>
			{% else %}
				<li class="nav-item"><a href="{{ BASE_PATH }}{{node.url}}" class="nav-link">{{node.title}}</a></li>
			{% endif %}
		{% endif %}
	{% endif %}
{% endfor %}
